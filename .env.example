# .env.example: reference only. Copy to .env if you use it with docker compose; never commit .env.
#
# The workflow itself does NOT read environment variables for secrets.
# API keys belong in n8n credentials (Credentials -> Add Credential), which n8n stores encrypted.
# This file lists what you will need when moving from demo mode to production.

# --- n8n instance (only if you run n8n via docker compose) ---
N8N_PORT=6082
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:6082/
GENERIC_TIMEZONE=Europe/London
# Generate your own long random value; keep it stable, it encrypts stored credentials.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# --- Values to paste into n8n credentials (NOT read by the workflow) ---
# Header Auth credential for "AI · Analyze Lead" / "AI · Draft Follow-up"
#   Anthropic:          header name x-api-key       value <your Anthropic API key>
#   OpenAI-compatible:  header name Authorization   value Bearer <your key>
AI_API_KEY=replace-me

# HubSpot App Token credential for "CRM · HubSpot Upsert Contact"
HUBSPOT_APP_TOKEN=replace-me

# Header Auth credential for "CRM · Generic CRM API"
CRM_API_KEY=replace-me
